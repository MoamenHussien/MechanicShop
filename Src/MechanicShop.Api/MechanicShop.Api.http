### Get all customers
GET {{baseUrl}}/api/v1/customers
Authorization: Bearer {{token}}

### Get a customer
GET {{baseUrl}}/api/v1/customers/{{customerMoamenId}}
Authorization: Bearer {{token}}

### Get all VehicleMakes
GET {{baseUrl}}/v1/makes
Authorization: Bearer {{token}}

### Get all VehicleModels
GET {{baseUrl}}/v1/makes/{33333333-3333-3333-3333-333333333333}
Authorization: Bearer {{token}}

### Get all labors
GET {{baseUrl}}/v1/labors
Authorization: Bearer {{token}}

### Get all repair task
GET {{baseUrl}}/v1/repair-tasks
Authorization: Bearer {{token}}

### Get a Repair task
GET {{baseUrl}}/v1/repair-tasks/ffffffff-ffff-ffff-ffff-000000000001
Authorization: Bearer {{token}}


### Get all workorders
GET {{baseUrl}}/v1/workorders
Authorization: Bearer {{token}}


### search workorders
GET {{baseUrl}}/v1/workorders?page=1&pageSize=20&searchTerm=Comp&sortColumn=serviceId
Authorization: Bearer {{token}}


### Get workorder by Id 
GET {{baseUrl}}/v1/workorders/{{workorderId}}
Authorization: Bearer {{token}}

### Create workorder
POST {{baseUrl}}/v1/workorders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "spot": 1,
  "vehicleId": "a691e588-9f5c-44ec-b89d-462a80c0dd5c",
  "repairTaskIds": ["ffffffff-ffff-ffff-ffff-000000000001"],
  "laborId": "{{labor01Id}}",
  "startAtUtc": "2026-07-10T10:00:00Z"
}

### Update workorder Timing
PUT {{baseUrl}}/v1/workorders/{{workorderId}}/relocation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "DateTimeOffset": "2026-07-02T14:00:00Z",
  "NewSpot": "3"
}

### Update workorder labor
PUT {{baseUrl}}/v1/workorders/{{workorderId}}/labor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "laborId": "{{labor01Id}}"
}

### Update workorder state
PUT {{baseUrl}}/v1/workorders/{{workorderId}}/state
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "NewStatus": {{Completed}}
}

### delete workorder
DELETE {{baseUrl}}/v1/workorders/{{workorderId}}
Authorization: Bearer {{token}}

### Invoice workorder
POST {{baseUrl}}/v1/invoices/workorders/{{workorderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Get Invoice by Id 
GET {{baseUrl}}/v1/invoices/{{invoiceId}}
Authorization: Bearer {{token}}

### Get Invoice in PDF
GET {{baseUrl}}/v1/invoices/{{invoiceId}}/pdf
Authorization: Bearer {{token}}

### Get today schedule workorder
GET {{baseUrl}}/v1/workorders/schedule
Authorization: Bearer {{token}}

### Get specific day schedule workorder
GET {{baseUrl}}/v1/workorders/schedule/2026-07-01?laborId=b6327240-0aea-46fc-863a-777fc4e42560
X-TimeZone: America/Montreal
Authorization: Bearer {{token}}