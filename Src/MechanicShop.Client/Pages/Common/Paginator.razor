@if (TotalPages > 1)
{
    <nav class="records-pagination" aria-label="Work order pages">
        <ul class="pagination mb-0">
            @if (DisplayPage > 1)
            {
                <li class="page-item"><a class="page-link" href="@GetUrl(1)" aria-label="First page"><i class="bi bi-chevron-double-left" aria-hidden="true"></i></a></li>
            }
            @for (int i = StartPage; i <= MaxPage; i++)
            {
                <li class="page-item @(DisplayPage == i ? "active" : string.Empty)"><a class="page-link" href="@GetUrl(i)" aria-current="@(DisplayPage == i ? "page" : null)" aria-label="@($"Page {i}")">@i</a></li>
            }
            @if (DisplayPage < TotalPages)
            {
                <li class="page-item"><a class="page-link" href="@GetUrl(TotalPages)" aria-label="Last page"><i class="bi bi-chevron-double-right" aria-hidden="true"></i></a></li>
            }
        </ul>
        <p class="pagination-summary">Showing @((DisplayPage - 1) * ItemsPerPage + 1)–@(Math.Min(DisplayPage * ItemsPerPage, TotalItems)) of @TotalItems <span>Page @DisplayPage of @TotalPages</span></p>
    </nav>
}

@code {
    [Parameter] public string NavUrl { get; set; } = string.Empty;
    [Parameter] public int CurrentPageNumber { get; set; } = 1;
    [Parameter] public int ItemsPerPage { get; set; } = 30;
    [Parameter] public int TotalItems { get; set; }
    public int TotalPages => TotalItems <= 0 || ItemsPerPage <= 0 ? 1 : (int)Math.Ceiling((double)TotalItems / ItemsPerPage);
    private int DisplayPage => Math.Clamp(CurrentPageNumber, 1, TotalPages);
    public int StartPage => Math.Max(1, DisplayPage - 2);
    public int MaxPage => Math.Min(StartPage + 4, TotalPages);
    public string GetUrl(int page) => $"{NavUrl}{page}";
}
