@page "/employees"
@using System.Security.Claims
@using MechanicShop.Client.Components
@using MechanicShop.Client.Models
@using MechanicShop.Client.Services
@using MechanicShop.Contracts.Requests.Labors
@attribute [Authorize(Roles = "Manager")]
@inject ServiceApi ApiService

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-body-emphasis">
                <i class="bi bi-people me-2 brand-red"></i>Employee Management
            </h1>
            <p class="text-muted mb-0">Manage employees, roles, and permissions</p>
        </div>
        <button class="btn btn-primary btn-md-lg align-self-start align-self-sm-auto" @onclick="ShowAddDialog">
            <i class="bi bi-plus-lg me-1"></i> Add Employee
        </button>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(pageErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @pageErrorMessage
            <button type="button" class="btn-close" @onclick="() => pageErrorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(pageSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @pageSuccessMessage
            <button type="button" class="btn-close" @onclick="() => pageSuccessMessage = null"></button>
        </div>
    }

    <!-- Employee List Table -->
    <div class="card border-0 shadow-sm bg-body-secondary mb-4">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted m-0">Loading employees...</p>
                </div>
            }
            else if (!employees.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-people display-1 text-muted opacity-50"></i>
                    </div>
                    <h4 class="text-muted">No employees found</h4>
                    <p class="text-muted mb-3">Start by adding your first employee to the system.</p>
                    <button class="btn btn-primary" @onclick="ShowAddDialog">
                        <i class="bi bi-plus-lg me-1"></i> Add Employee
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in employees)
                            {
                                <tr>
                                    <td class="fw-semibold">@emp.FirstName</td>
                                    <td>@emp.LastName</td>
                                    <td class="font-monospace text-muted small">@emp.Email</td>
                                    <td>
                                        @if (emp.Roles.Any())
                                        {
                                            @foreach (var role in emp.Roles)
                                            {
                                                <span class="badge bg-primary me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Labor</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditDialog(emp)">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowResetPasswordConfirmation(emp)">
                                            <i class="bi bi-key me-1"></i>Reset Password
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Employee Dialog -->
<TemplatedDialog Show="showAddDialog" OnClose="HideAddDialog" Title="@(builder => builder.AddContent(0, "Add New Employee"))">
    <EditForm Model="addModel" OnValidSubmit="HandleAddEmployee">
        @if (!string.IsNullOrEmpty(dialogErrorMessage))
        {
            <div class="alert alert-danger p-2 small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @dialogErrorMessage
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label text-light small">First Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" 
                       @bind="addModel.FirstName" required placeholder="First Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label text-light small">Last Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" 
                       @bind="addModel.LastName" required placeholder="Last Name" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-light small">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control form-control-sm bg-dark text-light border-secondary" 
                   @bind="addModel.Email" required placeholder="employee@example.com" />
        </div>

        <div class="mb-3">
            <label class="form-label text-light small mb-2">Assign Roles</label>
            <div class="p-3 bg-secondary bg-opacity-10 border border-secondary rounded">
                @if (assignableRoles.Any())
                {
                    @foreach (var role in assignableRoles)
                    {
                        <div class="form-check me-3 d-inline-block">
                            <input class="form-check-input" type="checkbox" id="@($"add_role_{role}")" 
                                   checked="@addSelectedRoles.Contains(role)"
                                   @onchange="(e) => ToggleAddRole(role, e.Value)" />
                            <label class="form-check-label text-light small" for="@($"add_role_{role}")">
                                @role
                            </label>
                        </div>
                    }
                }
                else
                {
                    <div class="form-check me-3 d-inline-block">
                        <input class="form-check-input" type="checkbox" id="add_role_labor" checked disabled />
                        <label class="form-check-label text-light small" for="add_role_labor">Labor</label>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="HideAddDialog" disabled="@isSubmitting">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                    <span>Create Employee</span>
                }
            </button>
        </div>
    </EditForm>
</TemplatedDialog>

<!-- Edit Employee Dialog -->
<TemplatedDialog Show="showEditDialog" OnClose="HideEditDialog" Title="@(builder => builder.AddContent(0, "Edit Employee"))">
    <EditForm Model="editModel" OnValidSubmit="HandleEditEmployee">
        @if (!string.IsNullOrEmpty(dialogErrorMessage))
        {
            <div class="alert alert-danger p-2 small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @dialogErrorMessage
            </div>
        }

        <div class="mb-3">
            <label class="form-label text-secondary small">Email Address (Read-only)</label>
            <input type="email" class="form-control form-control-sm bg-dark text-light border-secondary opacity-75" 
                   value="@editModel.Email" readonly disabled />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label text-light small">First Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" 
                       @bind="editModel.FirstName" required />
            </div>
            <div class="col-md-6">
                <label class="form-label text-light small">Last Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" 
                       @bind="editModel.LastName" required />
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" role="switch" id="editActiveSwitch" @bind="editModel.IsActive" />
                <label class="form-check-label text-light small" for="editActiveSwitch">
                    Active Account Status
                </label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-light small mb-2">Assign Roles</label>
            <div class="p-3 bg-secondary bg-opacity-10 border border-secondary rounded">
                @if (assignableRoles.Any())
                {
                    @foreach (var role in assignableRoles)
                    {
                        <div class="form-check me-3 d-inline-block">
                            <input class="form-check-input" type="checkbox" id="@($"edit_role_{role}")" 
                                   checked="@editSelectedRoles.Contains(role)"
                                   @onchange="(e) => ToggleEditRole(role, e.Value)" />
                            <label class="form-check-label text-light small" for="@($"edit_role_{role}")">
                                @role
                            </label>
                        </div>
                    }
                }
                else
                {
                    <div class="form-check me-3 d-inline-block">
                        <input class="form-check-input" type="checkbox" id="edit_role_labor" checked disabled />
                        <label class="form-check-label text-light small" for="edit_role_labor">Labor</label>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <button type="button" class="btn btn-outline-warning btn-sm" @onclick="() => TriggerResetFromEdit()" disabled="@isSubmitting">
                <i class="bi bi-key me-1"></i> Reset Password
            </button>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="HideEditDialog" disabled="@isSubmitting">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </EditForm>
</TemplatedDialog>

<!-- Reset Password Confirmation Dialog -->
<ConfirmationDialog Show="showResetConfirmation"
                    Title="Reset Employee Password"
                    Message="@($"Are you sure you want to reset the password for {targetEmployeeForReset?.FirstName} {targetEmployeeForReset?.LastName} ({targetEmployeeForReset?.Email})?")"
                    SubText="The password will be reset to the default account setting managed by the server."
                    ConfirmButtonText="Reset Password"
                    IsProcessing="isSubmitting"
                    OnConfirm="ConfirmResetPassword"
                    OnCancel="() => showResetConfirmation = false" />

@code {
    private List<EmployeeModel> employees = [];
    private List<string> assignableRoles = [];

    private bool isLoading = true;
    private bool isSubmitting = false;

    private string? pageErrorMessage;
    private string? pageSuccessMessage;
    private string? dialogErrorMessage;

    // Add Form State
    private bool showAddDialog = false;
    private EmployeeModel addModel = new();
    private List<string> addSelectedRoles = [];

    // Edit Form State
    private bool showEditDialog = false;
    private EmployeeModel editModel = new();
    private List<string> editSelectedRoles = [];

    // Reset Password State
    private bool showResetConfirmation = false;
    private EmployeeModel? targetEmployeeForReset;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignableRoles();
        await LoadEmployees();
    }

    private async Task LoadAssignableRoles()
    {
        var rolesResult = await ApiService.GetAssignableRolesAsync();
        if (rolesResult.IsSuccess && rolesResult.Data != null)
        {
            assignableRoles = rolesResult.Data;
        }
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        pageErrorMessage = null;

        try
        {
            var result = await ApiService.GetEmployeesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                employees = result.Data;
            }
            else
            {
                pageErrorMessage = result.ErrorMessage ?? "Failed to load employees.";
            }
        }
        catch (Exception)
        {
            pageErrorMessage = "An unexpected error occurred while loading employees. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Add Handlers
    private void ShowAddDialog()
    {
        addModel = new EmployeeModel();
        addSelectedRoles = assignableRoles.Any() ? [assignableRoles.First()] : ["Labor"];
        dialogErrorMessage = null;
        showAddDialog = true;
    }

    private void HideAddDialog()
    {
        showAddDialog = false;
    }

    private void ToggleAddRole(string role, object? isChecked)
    {
        if (isChecked is bool checkedVal)
        {
            if (checkedVal && !addSelectedRoles.Contains(role))
                addSelectedRoles.Add(role);
            else if (!checkedVal && addSelectedRoles.Contains(role))
                addSelectedRoles.Remove(role);
        }
    }

    private async Task HandleAddEmployee()
    {
        dialogErrorMessage = null;

        if (string.IsNullOrWhiteSpace(addModel.FirstName) || string.IsNullOrWhiteSpace(addModel.LastName))
        {
            dialogErrorMessage = "First Name and Last Name are required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(addModel.Email) || !addModel.Email.Contains("@"))
        {
            dialogErrorMessage = "A valid Email address is required.";
            return;
        }

        isSubmitting = true;

        try
        {
            var request = new RegisterLaborRequestContract
            {
                FirstName = addModel.FirstName.Trim(),
                LastName = addModel.LastName.Trim(),
                Email = addModel.Email.Trim(),
                Password = "DefP@ssw0rd!" + Guid.NewGuid().ToString("N")[..6],
                Roles = addSelectedRoles.Any() ? addSelectedRoles : ["Labor"]
            };

            var result = await ApiService.CreateLaborAsync(request);

            if (result.IsSuccess)
            {
                pageSuccessMessage = $"Employee {addModel.FirstName} {addModel.LastName} created successfully.";
                showAddDialog = false;
                await LoadEmployees();
            }
            else
            {
                dialogErrorMessage = result.ErrorMessage ?? "Failed to create employee.";
            }
        }
        catch (Exception ex)
        {
            dialogErrorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Edit Handlers
    private void ShowEditDialog(EmployeeModel emp)
    {
        editModel = new EmployeeModel
        {
            LaborId = emp.LaborId,
            FirstName = emp.FirstName,
            LastName = emp.LastName,
            Email = emp.Email,
            IsActive = emp.IsActive,
            Roles = [.. emp.Roles]
        };
        editSelectedRoles = emp.Roles.Any() ? [.. emp.Roles] : (assignableRoles.Any() ? [assignableRoles.First()] : ["Labor"]);
        dialogErrorMessage = null;
        showEditDialog = true;
    }

    private void HideEditDialog()
    {
        showEditDialog = false;
    }

    private void ToggleEditRole(string role, object? isChecked)
    {
        if (isChecked is bool checkedVal)
        {
            if (checkedVal && !editSelectedRoles.Contains(role))
                editSelectedRoles.Add(role);
            else if (!checkedVal && editSelectedRoles.Contains(role))
                editSelectedRoles.Remove(role);
        }
    }

    private async Task HandleEditEmployee()
    {
        if (editModel == null) return;

        dialogErrorMessage = null;

        if (string.IsNullOrWhiteSpace(editModel.FirstName) || string.IsNullOrWhiteSpace(editModel.LastName))
        {
            dialogErrorMessage = "First Name and Last Name are required.";
            return;
        }

        isSubmitting = true;

        try
        {
            var infoRequest = new UpdateLaborInfoRequest
            {
                FirstName = editModel.FirstName.Trim(),
                LastName = editModel.LastName.Trim(),
                IsActive = editModel.IsActive
            };

            var permRequest = new UpdateLaborPermissionsRequest
            {
                Roles = editSelectedRoles.Any() ? editSelectedRoles : ["Labor"],
                Claims = []
            };

            var infoTask = ApiService.UpdateLaborInfoAsync(editModel.LaborId, infoRequest);
            var permTask = ApiService.UpdateLaborPermissionsAsync(editModel.LaborId, permRequest);

            await Task.WhenAll(infoTask, permTask);

            var infoResult = await infoTask;
            var permResult = await permTask;

            if (infoResult.IsSuccess && permResult.IsSuccess)
            {
                pageSuccessMessage = $"Employee {editModel.FirstName} {editModel.LastName} updated successfully.";
                showEditDialog = false;
                await LoadEmployees();
            }
            else
            {
                var infoErr = !infoResult.IsSuccess ? (infoResult.ErrorMessage ?? "Basic info update failed") : null;
                var permErr = !permResult.IsSuccess ? (permResult.ErrorMessage ?? "Permissions update failed") : null;
                dialogErrorMessage = string.Join(" | ", new[] { infoErr, permErr }.Where(e => e != null));
                await LoadEmployees();
            }
        }
        catch (Exception)
        {
            dialogErrorMessage = "An unexpected error occurred while updating employee details. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Reset Password Handlers
    private void ShowResetPasswordConfirmation(EmployeeModel emp)
    {
        targetEmployeeForReset = emp;
        showResetConfirmation = true;
    }

    private void TriggerResetFromEdit()
    {
        targetEmployeeForReset = editModel;
        showResetConfirmation = true;
    }

    private void HideResetPasswordConfirmation()
    {
        showResetConfirmation = false;
        targetEmployeeForReset = null;
    }

    private async Task ConfirmResetPassword()
    {
        if (targetEmployeeForReset == null) return;

        isSubmitting = true;

        try
        {
            var result = await ApiService.ResetLaborPasswordAsync(targetEmployeeForReset.LaborId);

            if (result.IsSuccess)
            {
                pageSuccessMessage = $"Password reset successfully for {targetEmployeeForReset.FirstName} {targetEmployeeForReset.LastName}.";
                showResetConfirmation = false;
                showEditDialog = false;
                await LoadEmployees();
            }
            else
            {
                pageErrorMessage = result.ErrorMessage ?? "Failed to reset password.";
                showResetConfirmation = false;
            }
        }
        catch (Exception)
        {
            pageErrorMessage = "An unexpected error occurred while resetting password. Please try again.";
            showResetConfirmation = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
