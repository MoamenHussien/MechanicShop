@page "/login"
@using MechanicShop.Client.Components

<PageTitle>Sign in | MechanicShop</PageTitle>

<div class="login-container">
    <AuthorizeView>
        <Authorized>
            <section class="signed-in-panel">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <h1>You're ready to go.</h1>
                <p>Signed in as @context.User.Identity?.Name</p>
                <a href="/" class="btn btn-primary">Open your workspace</a>
            </section>
        </Authorized>
        <NotAuthorized>
            <div class="login-introduction">
                <span class="login-symbol"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i></span>
                <h2>Good work starts<br />with a clear plan.</h2>
                <p>Your customers, your team and every job in between. All together, ready for the day ahead.</p>
                <div class="login-workflow">
                    <div><i class="bi bi-calendar3" aria-hidden="true"></i><span>Plan the day<small>Give every job its time and place.</small></span></div>
                    <div><i class="bi bi-clipboard-check" aria-hidden="true"></i><span>Keep work moving<small>Follow each repair from start to finish.</small></span></div>
                    <div><i class="bi bi-receipt" aria-hidden="true"></i><span>Take care of the details<small>Clear records, costs and invoicing.</small></span></div>
                </div>
                <span class="login-intro-footer">Built around the way a workshop works.</span>
            </div>
            <div class="login-card">
                <a href="/" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to home</a>
                <h1>Welcome back.</h1>
                <p class="login-subtitle">Sign in to your workshop workspace.</p>

                <EditForm Model="loginRequest" OnValidSubmit="HandleLogin" Context="loginFormContext">
                    <DataAnnotationsValidator />
                    <div class="mb-4">
                        <label for="login-email" class="form-label">Email or username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <InputText id="login-email" class="form-control" @bind-Value="loginRequest.Email" placeholder="you@example.com" autocomplete="username" required />
                        </div>
                        <ValidationMessage For="@(() => loginRequest.Email)" class="text-danger small mt-1" />
                    </div>
                    <div class="mb-3">
                        <label for="login-password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <InputText id="login-password" type="password" class="form-control" @bind-Value="loginRequest.Password" placeholder="Enter your password" autocomplete="current-password" required />
                        </div>
                        <ValidationMessage For="@(() => loginRequest.Password)" class="text-danger small mt-1" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                        <div class="form-check mb-0">
                            <InputCheckbox class="form-check-input" @bind-Value="loginRequest.RememberMe" id="remember" />
                            <label class="form-check-label text-muted small" for="remember">Remember me</label>
                        </div>
                        <button type="button" class="btn btn-link demo-help" @onclick="ShowDemoAccountModal">Demo accounts</button>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span role="status">Signing in...</span>
                        }
                        else
                        {
                            <span>Sign in</span><i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                        }
                    </button>
                </EditForm>
                @if (errors)
                {
                    <div class="alert alert-danger mt-4 mb-0 small" role="alert">
                        <strong>We couldn't sign you in.</strong>
                        <ul class="mb-0 ps-3 mt-2">
                            @foreach (var error in errorList) { <li>@error</li> }
                        </ul>
                    </div>
                }
                <div class="demo-access">
                    <span>Just taking a look? Choose a demo account.</span>
                    <div class="demo-buttons">
                        <button type="button" @onclick='() => AutoFill("pm@localhost", "pm@localhost")'><i class="bi bi-person-gear" aria-hidden="true"></i><span>Manager<small>Manage the whole workshop</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                        <button type="button" @onclick='() => AutoFill("john.labor@localhost", "john.labor@localhost")'><i class="bi bi-tools" aria-hidden="true"></i><span>Technician<small>Focus on assigned work</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                    </div>
                    <p>Select an account to fill the form, then sign in.</p>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
<TemplatedDialog Show="_showDemoModal" OnClose="HideDemoModal">
    <Title>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-key-fill text-danger fs-5 me-1" aria-hidden="true"></i>
            <span>Demo Accounts Help</span>
        </div>
    </Title>
    <ChildContent>
        <div class="p-1">
            <p class="text-muted small mb-3">
                Password reset is disabled for demonstration environments. Please use one of the pre-seeded demonstration accounts below:
            </p>

            <div class="card bg-body-tertiary border-secondary-subtle mb-3 p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="badge bg-danger mb-1">Manager Account</div>
                        <div class="fw-bold text-body-emphasis small">pm@localhost</div>
                        <div class="text-muted extra-small">Full administrative, billing & scheduling access</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick='() => AutoFill("pm@localhost", "pm@localhost")'>
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Auto Fill
                    </button>
                </div>
            </div>

            <div class="card bg-body-tertiary border-secondary-subtle mb-3 p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="badge bg-primary mb-1">Labor Account</div>
                        <div class="fw-bold text-body-emphasis small">john.labor@localhost</div>
                        <div class="text-muted extra-small">Assigned work order updates & personal schedule view</div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick='() => AutoFill("john.labor@localhost", "john.labor@localhost")'>
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Auto Fill
                    </button>
                </div>
            </div>

            <div class="text-end pt-2">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="HideDemoModal">Close</button>
            </div>
        </div>
    </ChildContent>
</TemplatedDialog>

@code {
    [Inject]
    private IAccountManagement accountManagement { get; set; } = default!;
    [Inject]
    private NavigationManager navigationManager { get; set; } = default!;

    private LoginRequest loginRequest = new();
    private bool success, errors, isSubmitting, _showDemoModal;
    private string[] errorList = [];

    private void ShowDemoAccountModal()
    {
        _showDemoModal = true;
    }

    private void HideDemoModal()
    {
        _showDemoModal = false;
    }

    private void AutoFill(string email, string password)
    {
        loginRequest.Email = email;
        loginRequest.Password = password;
        _showDemoModal = false;
    }

    private async Task HandleLogin()
    {
        success = errors = false;
        isSubmitting = true;
        errorList = [];

        try
        {
            var result = await accountManagement.LoginAsync(loginRequest.Email, loginRequest.Password);

            if (result.Succeeded)
            {
                success = true;
                errors = false;
                navigationManager.NavigateTo("/");
            }
            else
            {
                errors = true;
                errorList = result.ErrorList;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
