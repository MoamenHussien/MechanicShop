@page "/makes"
@using MechanicShop.Client.Components
@using MechanicShop.Client.Models
@using MechanicShop.Client.Services
@attribute [Authorize(Roles = "Manager")]
@inject ServiceApi ApiService

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-car-front me-2 text-primary"></i>Vehicle Makes Management</h2>
            <p class="text-secondary small mb-0">Manage vehicle makes and their associated models catalog</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="ShowCreateDialog">
            <i class="bi bi-plus-lg"></i>
            <span>Add Vehicle Make</span>
        </button>
    </div>

    <!-- Alert / Error message -->
    @if (!string.IsNullOrEmpty(pageErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@pageErrorMessage
            <button type="button" class="btn-close" @onclick="() => pageErrorMessage = null"></button>
        </div>
    }

    <!-- Content Table -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading vehicle makes...</span>
            </div>
            <p class="text-secondary mt-2 small">Loading vehicle makes...</p>
        </div>
    }
    else if (makes.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-car-front display-4 text-secondary mb-3 d-block"></i>
                <h5 class="fw-semibold">No Vehicle Makes Found</h5>
                <p class="text-secondary small mb-3">Get started by creating your first vehicle make and model entry.</p>
                <button class="btn btn-primary btn-sm" @onclick="ShowCreateDialog">
                    <i class="bi bi-plus-lg me-1"></i>Add Vehicle Make
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">Make Name</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var make in makes)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold vehicle-make-name">
                                    <i class="bi bi-tag-fill me-2 text-primary opacity-75"></i>@make.VehicleMake
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditDialog(make)" title="Edit Make & Models">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Reusable Single Modal Dialog for Create and Edit -->
<TemplatedDialog Show="showMakeDialog"
                 OnClose="CloseMakeDialog"
                 Title="@(builder => builder.AddContent(0, isEditMode ? "Edit Vehicle Make" : "Add Vehicle Make"))">
    @if (!string.IsNullOrEmpty(dialogErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 small mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>@dialogErrorMessage
            <button type="button" class="btn-close py-2" @onclick="() => dialogErrorMessage = null"></button>
        </div>
    }

    @if (isDialogLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading models...</span>
            </div>
            <p class="text-secondary small mt-2 mb-0">Loading models...</p>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label fw-semibold small">Vehicle Make Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" placeholder="e.g. Toyota, Ford, BMW" @bind="formMakeName" disabled="@isSubmitting" />
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-semibold small mb-0">Vehicle Models <span class="text-danger">*</span></label>
                <button type="button" class="btn btn-sm btn-outline-success py-1 px-2" @onclick="AddModelRow" disabled="@isSubmitting">
                    <i class="bi bi-plus-lg me-1"></i>Add Model
                </button>
            </div>

            @if (formModels.Count == 0)
            {
                <div class="alert alert-warning py-2 px-3 small mb-0" role="alert">
                    <i class="bi bi-info-circle me-1"></i>At least one vehicle model is required.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                    @for (int i = 0; i < formModels.Count; i++)
                    {
                        var index = i;
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary">#@(index + 1)</span>
                            <input type="text" class="form-control" placeholder="Model Name (e.g. Camry, F-150)" @bind="formModels[index].Model" disabled="@isSubmitting" />
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseMakeDialog" disabled="@isSubmitting">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="SaveMakeAsync" disabled="@(isSubmitting || isDialogLoading)">
            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Saving...</span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
                <span>@(isEditMode ? "Save Changes" : "Create Make")</span>
            }
        </button>
    </div>
</TemplatedDialog>

@code {
    private List<VehicleMakeModel> makes = [];
    private bool isLoading = true;
    private string? pageErrorMessage;

    // Modal state
    private bool showMakeDialog = false;
    private bool isEditMode = false;
    private bool isSubmitting = false;
    private bool isDialogLoading = false;
    private string? dialogErrorMessage;

    // Form inputs
    private Guid editingMakeId = Guid.Empty;
    private string formMakeName = string.Empty;
    private List<VehicleModelItemModel> formModels = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadMakes();
    }

    private async Task LoadMakes()
    {
        isLoading = true;
        pageErrorMessage = null;

        try
        {
            var result = await ApiService.GetVehicleMakesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                makes = result.Data;
            }
            else
            {
                pageErrorMessage = result.ErrorMessage ?? "Failed to load vehicle makes.";
            }
        }
        catch (Exception)
        {
            pageErrorMessage = "An unexpected error occurred while loading vehicle makes. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateDialog()
    {
        isEditMode = false;
        editingMakeId = Guid.Empty;
        formMakeName = string.Empty;
        formModels = [ new VehicleModelItemModel() ];
        dialogErrorMessage = null;
        isDialogLoading = false;
        showMakeDialog = true;
    }

    private async Task ShowEditDialog(VehicleMakeModel make)
    {
        isEditMode = true;
        editingMakeId = make.MakeId;
        formMakeName = make.VehicleMake;
        formModels = [];
        dialogErrorMessage = null;
        isDialogLoading = true;
        showMakeDialog = true;

        try
        {
            var modelsResult = await ApiService.GetVehicleModelsByMakeIdAsync(make.MakeId);
            if (modelsResult.IsSuccess && modelsResult.Data != null)
            {
                formModels = modelsResult.Data;
            }
            else
            {
                dialogErrorMessage = modelsResult.ErrorMessage ?? "Failed to load vehicle models for editing.";
            }
        }
        catch (Exception)
        {
            dialogErrorMessage = "An unexpected error occurred while loading vehicle models. Please try again.";
        }
        finally
        {
            isDialogLoading = false;
        }
    }

    private void CloseMakeDialog()
    {
        if (!isSubmitting)
        {
            showMakeDialog = false;
        }
    }

    private void AddModelRow()
    {
        formModels.Add(new VehicleModelItemModel());
    }

    private async Task SaveMakeAsync()
    {
        dialogErrorMessage = null;

        // Client-side validation checks
        if (string.IsNullOrWhiteSpace(formMakeName))
        {
            dialogErrorMessage = "Vehicle make name is required.";
            return;
        }

        var validModels = formModels
            .Where(m => !string.IsNullOrWhiteSpace(m.Model))
            .ToList();

        if (validModels.Count == 0)
        {
            dialogErrorMessage = "At least one valid model name is required.";
            return;
        }

        isSubmitting = true;

        try
        {
            if (!isEditMode)
            {
                // Create Mode
                var modelNames = validModels.Select(m => m.Model.Trim()).ToList();
                var result = await ApiService.CreateVehicleMakeAsync(formMakeName.Trim(), modelNames);

                if (result.IsSuccess)
                {
                    showMakeDialog = false;
                    await LoadMakes();
                }
                else
                {
                    dialogErrorMessage = result.ErrorMessage ?? "Failed to create vehicle make.";
                }
            }
            else
            {
                // Edit Mode
                var result = await ApiService.UpdateVehicleMakeAsync(editingMakeId, formMakeName.Trim(), validModels);

                if (result.IsSuccess)
                {
                    showMakeDialog = false;
                    await LoadMakes();
                }
                else
                {
                    dialogErrorMessage = result.ErrorMessage ?? "Failed to update vehicle make.";
                }
            }
        }
        catch (Exception)
        {
            dialogErrorMessage = "An unexpected error occurred while saving vehicle make details. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
