@implements IAsyncDisposable

<div class="dashboard-heading">
    <div><p class="page-context">Workshop overview</p><h1>The day, at a glance.</h1><p class="text-muted mb-0">A clear view of your jobs, people and performance.</p></div>
    <div class="dashboard-date"><DatePickerComponent SelectedDate="_selectedDate" SelectedDateChanged="OnDashboardDateChanged" /></div>
</div>

<div class="dashboard-actions"><a href="schedules" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Schedule a job</a><a href="workorders" class="btn btn-outline-secondary">View work orders <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></a></div>

@if (_isLoading && data is null)
{
    <div class="dashboard-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading workshop overview...</div>
}
@if (_loadError is not null)
{
    <div class="alert alert-warning" role="alert">@_loadError</div>
}

<section class="order-metrics" aria-label="Work order status" aria-busy="@_isLoading.ToString().ToLowerInvariant()">
    <article class="stat-card stat-total"><span class="stat-label"><i class="bi bi-clipboard-data" aria-hidden="true"></i> Total orders</span><strong>@(data?.Total.ToString() ?? "—")</strong><span class="stat-footnote">For the selected day</span></article>
    <article class="stat-card"><span class="stat-label"><span class="metric-dot scheduled-dot"></span> Scheduled</span><strong>@(data?.Scheduled.ToString() ?? "—")</strong><span class="stat-footnote">Ready to get started</span></article>
    <article class="stat-card"><span class="stat-label"><span class="metric-dot progress-dot"></span> In progress</span><strong>@(data?.InProgress.ToString() ?? "—")</strong><span class="stat-footnote">On the workshop floor</span></article>
    <article class="stat-card"><span class="stat-label"><span class="metric-dot completed-dot"></span> Completed</span><strong>@(data?.Completed.ToString() ?? "—")</strong><span class="stat-footnote">Work wrapped up</span></article>
    <article class="stat-card"><span class="stat-label"><span class="metric-dot cancelled-dot"></span> Cancelled</span><strong>@(data?.Cancelled.ToString() ?? "—")</strong><span class="stat-footnote">No longer scheduled</span></article>
</section>

<section class="finance-section" aria-labelledby="finance-heading">
    <div class="dashboard-section-title"><h2 id="finance-heading">The numbers behind the work</h2><span>Financial overview</span></div>
    <div class="finance-metrics">
        <article class="finance-card revenue-card"><span><i class="bi bi-wallet2" aria-hidden="true"></i> Total revenue</span><strong>@(data is null ? "—" : FormatCurrency(data.TotalRevenue))</strong><small>Revenue from work orders</small></article>
        <article class="finance-card"><span><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Net profit</span><strong>@(data is null ? "—" : FormatCurrency(data.NetProfit))</strong><small>Revenue after parts and labor</small></article>
        <article class="finance-card"><span><i class="bi bi-box-seam" aria-hidden="true"></i> Parts cost</span><strong>@(data is null ? "—" : FormatCurrency(data.TotalPartsCost))</strong><small>Parts used across repair jobs</small></article>
        <article class="finance-card"><span><i class="bi bi-person-gear" aria-hidden="true"></i> Labor cost</span><strong>@(data is null ? "—" : FormatCurrency(data.TotalLaborCost))</strong><small>Cost of technician time</small></article>
    </div>
</section>

<div class="insight-panels">
    <section class="insight-panel" aria-labelledby="activity-heading"><div class="dashboard-section-title"><h2 id="activity-heading"><i class="bi bi-activity" aria-hidden="true"></i> Workshop activity</h2></div><dl class="insight-list">
        <div><dt>Unique vehicles</dt><dd>@(data?.UniqueVehicles.ToString() ?? "—")</dd></div>
        <div><dt>Unique customers</dt><dd>@(data?.UniqueCustomers.ToString() ?? "—")</dd></div>
        <div><dt>Completion rate</dt><dd>@(data is null ? "—" : string.Format("{0:F2}%", data.CompletionRate))</dd></div>
        <div><dt>Orders per vehicle</dt><dd>@(data is null ? "—" : string.Format("{0:F2}", data.OrdersPerVehicle))</dd></div>
        <div><dt>Cancellation rate</dt><dd>@(data is null ? "—" : string.Format("{0:F2}%", data.CancellationRate))</dd></div>
    </dl></section>
    <section class="insight-panel" aria-labelledby="performance-heading"><div class="dashboard-section-title"><h2 id="performance-heading"><i class="bi bi-pie-chart" aria-hidden="true"></i> Financial performance</h2></div><dl class="insight-list">
        <div><dt>Profit margin</dt><dd>@(data is null ? "—" : string.Format("{0:F2}%", data.ProfitMargin))</dd></div>
        <div><dt>Average revenue per order</dt><dd>@(data is null ? "—" : FormatCurrency(data.AverageRevenuePerOrder))</dd></div>
        <div><dt>Parts cost ratio</dt><dd>@(data is null ? "—" : string.Format("{0:F2}%", data.PartsCostRatio))</dd></div>
        <div><dt>Labor cost ratio</dt><dd>@(data is null ? "—" : string.Format("{0:F2}%", data.LaborCostRatio))</dd></div>
    </dl><a href="workorders" class="insight-link">Go to work orders <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></section>
</div>

@code {
    [Inject]
    private ServiceApi _serviceApi { get; set; } = default!;

    [Inject]
    private WorkOrderHubClient _hubClient { get; set; } = default!;

    [Inject]
    private NavigationManager _navigationManager { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    private DateTime _selectedDate = DateTime.Today;

    private TodayWorkOrderStatsModel? data;
    private bool _isLoading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await _hubClient.StartAsync(RefreshDashboard);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryDate) && DateTime.TryParse(QueryDate, CultureInfo.InvariantCulture, out var parsedDate))
        {
            _selectedDate = parsedDate;
        }
        else
        {
            _selectedDate = DateTime.Today;
        }

        await RefreshDashboard();
    }

    private void OnDashboardDateChanged(DateTime newDate)
    {
        _selectedDate = newDate;
        _navigationManager.NavigateTo($"/?date={newDate:yyyy-MM-dd}");
    }

    private string FormatCurrency(decimal amount)
    {
        return amount.ToString("C", CultureInfo.GetCultureInfo("en-us"));
    }

    private async Task RefreshDashboard()
    {
        _isLoading = true;
        _loadError = null;
        var statsData = await _serviceApi.GetTodayWorkOrderStatsAsync(DateOnly.FromDateTime(_selectedDate));

        if (statsData.IsSuccess)
        {
            data = statsData.Data;
        }
        else
        {
            _loadError = "The workshop overview couldn't be loaded. Choose the date again to retry.";
        }
        _isLoading = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubClient is not null)
        {
            try
            {
                await _hubClient.DisposeAsync();
            }
            catch
            {

            }
        }
    }
}
