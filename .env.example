# MechanicShop Secrets Environment Template (.env.example)
# Copy this file to .env and populate secret values before running docker compose up

# SQL Server SA Password
SA_PASSWORD=your_strong_sa_password_here

# JWT Signing Key (Minimum 32 characters)
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_here

# SMTP Credentials
MAIL_USERNAME=your_mail_username_here
MAIL_PASSWORD=your_mail_password_here

# Grafana Admin Password
GF_SECURITY_ADMIN_PASSWORD=your_grafana_admin_password_here
