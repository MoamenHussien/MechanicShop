root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
tab_width = 4
end_of_line = crlf

#### Modern C# conventions ####
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_style_readonly_field = true:warning

dotnet_naming_rule.private_fields_should_be__camelcase.severity = warning
dotnet_naming_rule.private_fields_should_be__camelcase.symbols = private_fields_symbol
dotnet_naming_rule.private_fields_should_be__camelcase.style = _camelcase_style
dotnet_naming_symbols.private_fields_symbol.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbol.applicable_accessibilities = private
dotnet_naming_style._camelcase_style.capitalization = camel_case
dotnet_naming_style._camelcase_style.required_prefix = _

dotnet_naming_rule.interfaces_should_start_with_i.severity = warning
dotnet_naming_rule.interfaces_should_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_start_with_i.style = i_pascalcase_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_pascalcase_style.capitalization = pascal_case
dotnet_naming_style.i_pascalcase_style.required_prefix = I

#### GROUP A — Documentation & header rules: never enforced (separate initiative, not a formatting task) ####
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1633.severity = none

#### GROUP B — Organizational / opinionated rules: silenced, team preference already decided elsewhere ####
dotnet_diagnostic.SA1101.severity = none  # this. prefix — team doesn't mandate it
dotnet_diagnostic.SA1200.severity = none  # using placement inside/outside namespace
dotnet_diagnostic.SA1201.severity = none  # member ordering — reordering risks field-initializer execution order, never auto-applied anyway
dotnet_diagnostic.SA1202.severity = none  # ordering by access modifier — same reason
dotnet_diagnostic.SA1204.severity = none  # static-before-instance ordering — same reason
dotnet_diagnostic.SA1208.severity = none  # System-usings-first ordering (cosmetic only)
dotnet_diagnostic.SA1210.severity = none  # Using directives ordering
dotnet_diagnostic.SA1309.severity = none  # "no underscore prefix" — contradicts the _camelCase convention chosen above
dotnet_diagnostic.SA1312.severity = none  # Local variable naming
dotnet_diagnostic.SA1402.severity = none  # one type per file — many valid patterns (CQRS command+validator+handler) intentionally group types
dotnet_diagnostic.SA1649.severity = none  # filename must match type name — same reason as SA1402

#### GROUP C — Rules fundamentally incompatible with positional records: silenced project-wide ####
# A positional record's constructor parameter name becomes its public property name
# (public record Foo(string Bar) generates `public string Bar { get; }`).
# StyleCop's naming analyzers predate records and cannot distinguish "record property"
# from "plain method parameter" or "private field," so they produce warnings that are
# either wrong (per Microsoft's own naming convention for records) or would require
# renaming a public property to "fix." This is an open, unresolved upstream limitation
# — see DotNetAnalyzers/StyleCopAnalyzers issues #3181, #3304, #3384, #3576.
dotnet_diagnostic.SA1300.severity = none  # element should begin with uppercase
dotnet_diagnostic.SA1306.severity = none  # field should begin with lowercase
dotnet_diagnostic.SA1307.severity = none  # field should begin with uppercase
dotnet_diagnostic.SA1311.severity = none  # static readonly field should begin with uppercase
dotnet_diagnostic.SA1313.severity = none  # parameter should begin with lowercase
dotnet_diagnostic.SA1314.severity = none  # type parameter should begin with T

#### GROUP D — Formatting, spacing & layout opinion rules without automated Roslyn code fixers: silenced ####
